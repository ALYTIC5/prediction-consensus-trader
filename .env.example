# Copy to .env and fill in real values. Never commit .env.

# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Where app.main writes logs/polybot.log. Defaults to ~/.polybot/logs if
# unset - deliberately outside any cloud-synced folder (OneDrive/Dropbox/etc)
# since background file replacement during sync can silently break an open
# log file handle. Only override this if you know your target directory
# isn't synced.
# LOG_DIR=/var/log/polybot

# Whether app.main also writes logs/polybot.log, on top of stdout (which is
# always on). Defaults to on for local dev, off in production (Railway
# captures stdout directly, and a Linux container has no OneDrive-style sync
# process to risk). Set explicitly to override either way.
# LOG_TO_FILE=false

# --- Database ---
# Local dev: use the POSTGRES_* vars below (built into a connection string
# by app/config/settings.py). On Railway: set DATABASE_URL instead - it's
# injected automatically by the Postgres plugin and takes priority over
# the POSTGRES_* vars whenever both happen to be present. Only one of the
# two is actually required, not both.
POSTGRES_USER=polybot
POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_password
POSTGRES_DB=polybot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Redis ---
# Local dev: the docker-compose default below. On Railway: set REDIS_URL to
# whatever the Redis plugin injects - same variable name either way.
REDIS_URL=redis://localhost:6379/0

# --- Dashboard auth ---
# Required whenever ENVIRONMENT=production (the app refuses to start
# without both set in that case) - the operations console has no other
# access control, and production deployments are reachable from outside
# the container. Leave both unset for local dev; the console stays
# localhost-only and unauthenticated, same as it always has been.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=CHANGE_ME_generate_a_long_random_password
